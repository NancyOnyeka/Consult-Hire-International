<!DOCTYPE html>
<html lang="en">
<head>
  <base target="_self">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Contact Us | Consult &amp; Hire</title>
  <meta name="description" content="Talk to Consult & Hire about hiring, recruitment advice, candidate support or general enquiries.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Patrick+Hand&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: "#111735",
            navy: "#17204E",
            purple: "#6532C9",
            violet: "#8B5CF6",
            lilac: "#F3ECFF",
            blueSoft: "#EDF5FF",
            line: "#E7E8EE",
            muted: "#626A7D"
          },
          fontFamily: {
            sans: ["Inter", "sans-serif"],
            hand: ["Patrick Hand", "cursive"]
          },
          boxShadow: {
            soft: "0 16px 40px rgba(23,32,78,.08)"
          }
        }
      }
    }
  </script>

  <style>
    html { scroll-behavior: smooth; }
    body { background: #fff; }
    .field {
      width: 100%;
      border: 1px solid #D9DCE6;
      border-radius: 9px;
      padding: .88rem 1rem;
      color: #111735;
      background: #fff;
      transition: border-color .2s ease, box-shadow .2s ease;
    }
    .field:focus {
      outline: none;
      border-color: #6532C9;
      box-shadow: 0 0 0 4px rgba(101,50,201,.10);
    }
    .mobile-menu { display: none; }
    .mobile-menu.open { display: block; }
    .scribble-line {
      height: 4px;
      border-radius: 999px;
      background: rgba(139,92,246,.48);
      transform: rotate(-1deg);
    }
  </style>
</head>

<body class="font-sans text-ink antialiased">

  <header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur">
    <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-20 items-center justify-between">
        <a href="index.html" class="text-2xl font-bold tracking-tight text-navy">
          consult<span class="text-purple">&amp;</span>hire
        </a>

        <div class="hidden items-center gap-8 md:flex">
          <a href="index.html" class="text-sm font-medium text-navy hover:text-purple">Home</a>
          <a href="employerhub.html" class="text-sm font-medium text-navy hover:text-purple">Employer Hub</a>
          <a href="candidatehub.html" class="text-sm font-medium text-navy hover:text-purple">Candidate Hub</a>
          <a href="about.html" class="text-sm font-medium text-navy hover:text-purple">About Us</a>
          <a href="insights.html" class="text-sm font-medium text-navy hover:text-purple">Insights</a>
          <a href="contact.html" class="rounded-lg border border-violet px-5 py-3 text-sm font-semibold text-purple hover:bg-lilac">
            Contact Us
          </a>
        </div>

        <button id="menuButton" type="button" class="md:hidden" aria-label="Open navigation" aria-expanded="false">
          <span class="block h-0.5 w-6 bg-navy"></span>
          <span class="mt-1.5 block h-0.5 w-6 bg-navy"></span>
          <span class="mt-1.5 block h-0.5 w-6 bg-navy"></span>
        </button>
      </div>

      <div id="mobileMenu" class="mobile-menu border-t border-line pb-5 md:hidden">
        <div class="flex flex-col gap-4 pt-5">
          <a href="index.html">Home</a>
          <a href="employerhub.html">Employer Hub</a>
          <a href="candidatehub.html">Candidate Hub</a>
          <a href="about.html">About Us</a>
          <a href="insights.html">Insights</a>
          <a href="contact.html" class="font-semibold text-purple">Contact Us</a>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="border-b border-line bg-white">
      <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 py-14 sm:px-6 md:py-20 lg:grid-cols-[.9fr_1.1fr] lg:px-8">
        <div>
          <p class="font-hand text-3xl text-purple">Let’s talk</p>
          <div class="scribble-line mt-1 w-24"></div>

          <h1 class="mt-8 max-w-xl text-4xl font-bold leading-tight text-navy md:text-6xl">
            Good conversations lead to great outcomes.
          </h1>

          <div class="scribble-line ml-36 mt-2 w-36"></div>

          <p class="mt-7 max-w-xl text-lg leading-8 text-muted">
            Whether you need to hire, want advice, or just want to explore what’s possible, we’re here to help.
            Get in touch — we’d love to hear from you.
          </p>

          <svg class="mt-5 h-16 w-20" viewBox="0 0 80 64" aria-hidden="true">
            <path d="M18 5 C11 23, 22 40, 48 47 M48 47 L38 35 M48 47 L31 51"
              fill="none" stroke="#8B5CF6" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <div class="mx-auto w-full max-w-2xl">
          <img
            src="Contact Images.png"
            class="h-auto w-full"
          >
        </div>
      </div>
    </section>

    <!-- Contact routes -->
    <section class="border-b border-line bg-white">
      <div class="mx-auto grid max-w-7xl px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">

        <a href="clientcalendar.html" class="border-b border-line px-7 py-10 text-center transition hover:bg-lilac/25 sm:border-r lg:border-b-0">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-lilac">
            <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
              <path d="M5 8 C5 4,10 3,16 3 C22 3,27 5,27 10 V17 C27 21,22 23,16 23 H11 L6 28 L8 22 C6 21,5 19,5 17Z"
                fill="none" stroke="#6532C9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="11" cy="13" r="1.2" fill="#6532C9"/>
              <circle cx="16" cy="13" r="1.2" fill="#6532C9"/>
              <circle cx="21" cy="13" r="1.2" fill="#6532C9"/>
            </svg>
          </div>
          <h2 class="mt-5 font-semibold text-purple">Book a Consultation</h2>
          <p class="mt-3 text-sm leading-6 text-muted">Schedule a free consultation to discuss your hiring challenges and goals.</p>
          <p class="mt-5 text-sm font-semibold text-purple">Book a time →</p>
        </a>

        <a href="submit-vacancy.html" class="border-b border-line px-7 py-10 text-center transition hover:bg-blueSoft/40 lg:border-b-0 lg:border-r">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-blueSoft">
            <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
              <rect x="5" y="10" width="22" height="16" rx="2" fill="none" stroke="#1467D8" stroke-width="2"/>
              <path d="M11 10 V7 C11 5,13 4,16 4 C19 4,21 5,21 7 V10 M5 16 H27 M14 16 V19 H18 V16"
                fill="none" stroke="#1467D8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h2 class="mt-5 font-semibold text-[#1467D8]">Submit a Vacancy</h2>
          <p class="mt-3 text-sm leading-6 text-muted">Share your vacancy and we’ll get to work finding the right people.</p>
          <p class="mt-5 text-sm font-semibold text-[#1467D8]">Submit a vacancy →</p>
        </a>

        <a href="candidatehub.html" class="border-b border-line px-7 py-10 text-center transition hover:bg-lilac/25 sm:border-r lg:border-b-0">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-lilac">
            <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
              <circle cx="16" cy="10" r="5" fill="none" stroke="#6532C9" stroke-width="2"/>
              <path d="M7 27 C7 20,10 17,16 17 C22 17,25 20,25 27Z"
                fill="none" stroke="#6532C9" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <h2 class="mt-5 font-semibold text-purple">For Candidates</h2>
          <p class="mt-3 text-sm leading-6 text-muted">Have a question about an application or opportunity? We’re happy to help.</p>
          <p class="mt-5 text-sm font-semibold text-purple">Candidate support →</p>
        </a>

        <a href="#contact-form" class="px-7 py-10 text-center transition hover:bg-blueSoft/40">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-blueSoft">
            <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
              <rect x="4" y="7" width="24" height="18" rx="2" fill="none" stroke="#1467D8" stroke-width="2"/>
              <path d="M5 9 L16 18 L27 9" fill="none" stroke="#1467D8" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <h2 class="mt-5 font-semibold text-[#1467D8]">General Enquiries</h2>
          <p class="mt-3 text-sm leading-6 text-muted">Anything else? Send us a message and we’ll get back to you soon.</p>
          <p class="mt-5 text-sm font-semibold text-[#1467D8]">Send a message →</p>
        </a>
      </div>
    </section>

    <!-- Form -->
    <section id="contact-form" class="bg-white">
      <div class="mx-auto grid max-w-7xl lg:grid-cols-[1.58fr_1fr]">
        <div class="border-b border-line px-4 py-12 sm:px-6 lg:border-b-0 lg:border-r lg:px-8">
          <p class="font-hand text-3xl text-navy">Send us a message</p>
          <div class="scribble-line mt-1 w-40"></div>

          <!-- Replace # with your form-processing endpoint -->
          <form action="#" method="post" class="mt-8 space-y-5">
            <div class="grid gap-5 md:grid-cols-2">
              <div>
                <label for="first-name" class="mb-2 block text-sm font-medium text-navy">First name <span class="text-red-500">*</span></label>
                <input id="first-name" name="first_name" type="text" class="field" placeholder="Your first name" required>
              </div>
              <div>
                <label for="last-name" class="mb-2 block text-sm font-medium text-navy">Last name <span class="text-red-500">*</span></label>
                <input id="last-name" name="last_name" type="text" class="field" placeholder="Your last name" required>
              </div>
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-medium text-navy">Work email <span class="text-red-500">*</span></label>
              <input id="email" name="email" type="email" class="field" placeholder="you@company.com" required>
            </div>

            <div>
              <label for="company" class="mb-2 block text-sm font-medium text-navy">Company</label>
              <input id="company" name="company" type="text" class="field" placeholder="Your company">
            </div>

            <div>
              <label for="message" class="mb-2 block text-sm font-medium text-navy">How can we help? <span class="text-red-500">*</span></label>
              <textarea id="message" name="message" rows="6" class="field resize-y" placeholder="Tell us a little about what you need help with..." required></textarea>
            </div>

            <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
              <button type="submit" class="rounded-lg bg-gradient-to-r from-purple to-violet px-9 py-3.5 font-semibold text-white shadow-soft">
                Send Message
              </button>

              <div class="flex items-center gap-3">
                <svg viewBox="0 0 42 24" class="h-7 w-12" aria-hidden="true">
                  <path d="M40 6 C28 8,21 15,8 15 M8 15 L15 9 M8 15 L16 21"
                    fill="none" stroke="#8B5CF6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <p class="font-hand text-xl leading-5 text-purple">
                  We’ll get back to you<br>as soon as we can!
                </p>
              </div>
            </div>

            <p class="text-xs text-muted">
              By submitting this form, you agree to our
              <a href="privacy.html" class="text-[#1467D8] hover:underline">Privacy Policy</a>.
            </p>
          </form>
        </div>

        <aside class="px-4 py-12 sm:px-6 lg:px-10">
          <p class="font-hand text-3xl text-navy">Other ways to reach us</p>
          <div class="scribble-line mt-1 w-36"></div>

          <div class="mt-8 space-y-6">
            <div class="flex gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-lilac text-xl text-purple">✉</div>
              <div>
                <p class="font-semibold text-navy">Email</p>
                <a href="mailto:hello@consultandhire.com" class="mt-1 block text-sm text-purple">hello@consultandhire.com</a>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blueSoft text-xl text-[#1467D8]">☎</div>
              <div>
                <p class="font-semibold text-navy">Phone</p>
                <a href="tel:+611300381292" class="mt-1 block text-sm text-[#1467D8]">1300 381 292</a>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-lilac text-xl text-purple">⌖</div>
              <div>
                <p class="font-semibold text-navy">Office</p>
                <p class="mt-1 text-sm leading-6 text-muted">Level 8, 330 Collins Street<br>Melbourne VIC 3000</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blueSoft text-xl text-[#1467D8]">◷</div>
              <div>
                <p class="font-semibold text-navy">Hours</p>
                <p class="mt-1 text-sm leading-6 text-muted">Monday – Friday<br>8:30am – 5:30pm AEST</p>
              </div>
            </div>
          </div>

          <div class="relative mt-8 bg-blueSoft px-7 py-6">
            <p class="font-hand text-2xl leading-8 text-navy">
              We’re real people who care about people.<br>
              No call centres, just helpful conversations.
            </p>
            <svg viewBox="0 0 60 30" class="absolute -bottom-2 right-2 h-8 w-14" aria-hidden="true">
              <path d="M8 20 C12 12,18 12,21 20 M28 24 C32 15,39 15,42 24 M49 12 L54 6"
                fill="none" stroke="#8B5CF6" stroke-width="3" stroke-linecap="round"/>
            </svg>
          </div>
        </aside>
      </div>
    </section>

    <!-- Closing strip -->
    <section class="border-t border-line bg-gradient-to-r from-lilac/70 via-white to-blueSoft/70">
      <div class="mx-auto flex max-w-7xl flex-col items-center gap-8 px-4 py-10 sm:px-6 md:flex-row lg:px-8">
        <img src="Contact Footer.png"
         <div>
          <h2 class="text-2xl font-semibold text-navy md:text-3xl">Let’s build something great together.</h2>
          <div class="scribble-line mt-2 w-40"></div>
          <p class="mt-4 text-muted">Strong teams. Better hires. Lasting impact. That’s what we’re here for.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line bg-white py-7">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 text-sm text-muted sm:px-6 md:flex-row lg:px-8">
      <p>&copy; 2026 Consult &amp; Hire. All rights reserved.</p>
      <div class="flex gap-5">
        <a href="privacy.html" class="hover:text-purple">Privacy</a>
        <a href="terms.html" class="hover:text-purple">Terms</a>
      </div>
    </div>
  </footer>

  <script>
    const menuButton = document.getElementById("menuButton");
    const mobileMenu = document.getElementById("mobileMenu");

    menuButton.addEventListener("click", () => {
      const open = mobileMenu.classList.toggle("open");
      menuButton.setAttribute("aria-expanded", String(open));
    });
  </script>
</body>
