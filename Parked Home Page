<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0a0a0a">
    <title>Consult & Hire | Global Tech Recruitment</title>
    <meta name="description" content="Consult & Hire connects ambitious organisations with exceptional technology talent across global markets.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            dark: "#0a0a0a",
                            blue: "#1e3a8a",
                            purple: "#581c87",
                            surface: "#171717"
                        }
                    },
                    fontFamily: {
                        sans: ["Inter", "sans-serif"]
                    }
                }
            }
        };
    </script>

    <style>
        html { scroll-behavior: smooth; }

        .gradient-bg {
            background: linear-gradient(135deg, #0a0a0a 0%, #1e1b4b 52%, #2e1065 100%);
        }

        .glass-effect {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .hero-logo {
            filter: drop-shadow(0 25px 50px rgba(0, 0, 0, 0.45));
        }

        .focus-ring:focus-visible {
            outline: 3px solid rgba(191, 219, 254, 0.95);
            outline-offset: 4px;
        }
    </style>
</head>

<body class="overflow-x-hidden bg-brand-dark font-sans text-gray-100 antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:text-brand-dark">Skip to content</a>

    <header class="fixed left-0 top-0 z-50 w-full border-b border-gray-800 bg-brand-dark/95 backdrop-blur-md">
        <nav class="container mx-auto px-4 sm:px-6 lg:px-8" aria-label="Primary navigation">
            <div class="flex h-20 items-center justify-between">
                <a href="index.html" class="focus-ring flex items-center space-x-3 rounded-lg">
                    <div class="gradient-bg flex h-12 w-12 items-center justify-center rounded-xl border border-gray-700">
                        <i class="fas fa-briefcase text-xl text-white"></i>
                    </div>
                    <div>
                        <span class="block text-xl font-bold text-white">Consult &amp; Hire</span>
                        <span class="block text-xs text-gray-400">Technology Talent Acquisition</span>
                    </div>
                </a>

                <div class="hidden items-center space-x-8 md:flex">
                    <ul id="desktop-nav" class="flex space-x-6"></ul>
                    <a href="register" class="focus-ring rounded-lg bg-brand-blue px-6 py-2.5 font-medium text-white transition-colors hover:bg-blue-700">Register or Hire</a>
                </div>

                <button id="mobile-menu-btn" class="focus-ring rounded-lg p-2 text-2xl text-white md:hidden" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </nav>

        <div id="mobile-menu" class="hidden border-t border-gray-800 bg-brand-surface md:hidden">
            <ul id="mobile-nav" class="space-y-2 px-4 py-4"></ul>
            <div class="px-4 pb-4">
                <a href="register.html" class="block rounded-lg bg-brand-blue px-6 py-3 text-center font-medium text-white hover:bg-blue-700">Register or Hire</a>
            </div>
        </div>
    </header>

    <main id="main-content">
        <section class="gradient-bg relative overflow-hidden pb-16 pt-32 lg:pb-20 lg:pt-36">
            <div class="absolute inset-0 opacity-20" aria-hidden="true">
                <div class="absolute left-0 top-0 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-500 blur-3xl"></div>
                <div class="absolute bottom-0 right-0 h-96 w-96 translate-x-1/2 translate-y-1/2 rounded-full bg-purple-500 blur-3xl"></div>
            </div>

            <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid items-center gap-10 lg:grid-cols-2">
                    <div>
                        <p class="mb-4 font-semibold uppercase tracking-widest text-blue-300">Global Tech Recruitment</p>
                        <h1 class="mb-6 text-4xl font-bold leading-tight text-white md:text-6xl">Experts in Global Tech Talent</h1>
                        <p class="mb-8 max-w-xl text-lg leading-relaxed text-gray-300 md:text-xl">Connecting ambitious organisations with exceptional technology talent across global markets.</p>

                        <div class="flex flex-col gap-4 sm:flex-row">
                            <a href="register.html" class="focus-ring rounded-lg bg-white px-8 py-4 text-center font-semibold text-brand-dark transition-colors hover:bg-gray-200">Submit a Hiring Enquiry</a>
                            <a href="register.html" class="focus-ring glass-effect rounded-lg px-8 py-4 text-center font-semibold text-white transition-colors hover:bg-white/10">Submit Your CV</a>
                        </div>
                    </div>

                    <div class="glass-effect flex min-h-[280px] items-center justify-center rounded-3xl p-6 md:p-9">
                        <img src="Logo_Website.png" alt="Consult & Hire logo" class="hero-logo w-full max-w-xl rounded-2xl object-contain">
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white py-14 text-gray-900 md:py-16">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
                    <div>
                        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-brand-purple">Our Expertise</p>
                        <h2 class="text-3xl font-bold leading-tight md:text-4xl">Specialist technology recruitment, delivered simply.</h2>
                    </div>

                    <div class="rounded-3xl border border-gray-200 bg-gray-50 p-7 shadow-sm md:p-9">
                        <h3 class="mb-6 text-2xl font-bold">We specialise in:</h3>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="flex gap-3"><i class="fas fa-check-circle mt-1 text-brand-blue"></i><p class="text-gray-700">Engineering, DevOps, Platform and SRE</p></div>
                            <div class="flex gap-3"><i class="fas fa-check-circle mt-1 text-brand-blue"></i><p class="text-gray-700">AI, Machine Learning and Data</p></div>
                            <div class="flex gap-3"><i class="fas fa-check-circle mt-1 text-brand-blue"></i><p class="text-gray-700">Technology leadership and executive search</p></div>
                            <div class="flex gap-3"><i class="fas fa-check-circle mt-1 text-brand-blue"></i><p class="text-gray-700">Talent intelligence and employer brand</p></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="contact" class="bg-brand-surface py-14 md:py-16">
            <div class="container mx-auto px-4 text-center sm:px-6 lg:px-8">
                <div class="mx-auto max-w-3xl">
                    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-blue-300">Consult &amp; Hire</p>
                    <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">Ready to discuss your next hire or career move?</h2>
                    <p class="mb-8 text-lg text-gray-400">Speak with our team about hiring, your next opportunity or a wider talent challenge.</p>
                    <div class="flex flex-col justify-center gap-4 sm:flex-row">
                        <a href="clientcalendar.html" class="focus-ring rounded-lg bg-white px-8 py-4 font-semibold text-brand-dark hover:bg-gray-200">Speak With Consult &amp; Hire</a>
                        <a href="mailto:hello@consultandhire.com" class="focus-ring rounded-lg border border-gray-700 px-8 py-4 font-semibold text-white hover:bg-white/5">Email Us</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="border-t border-gray-800 bg-black py-7">
        <div class="container mx-auto px-4 text-center sm:px-6 lg:px-8">
            <p class="text-sm text-gray-500">&copy; <span id="current-year"></span> Consult &amp; Hire. All rights reserved.</p>
        </div>
    </footer>

    <script>
        const navItems = [
            { label: "Employers", href: "employer.html" },
            { label: "Job Seekers", href: "candidate.html" },
            { label: "About Us", href: "about.html" },
            { label: "Contact", href: "contact.html" }
        ];

        function renderNavItems(items) {
            return items.map(item => `
                <li>
                    <a href="${item.href}" class="block rounded-md px-2 py-2 font-medium text-gray-300 transition-colors hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-200">
                        ${item.label}
                    </a>
                </li>
            `).join("");
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("desktop-nav").innerHTML = renderNavItems(navItems);
            document.getElementById("mobile-nav").innerHTML = renderNavItems(navItems);
            document.getElementById("current-year").textContent = new Date().getFullYear();

            const mobileMenuBtn = document.getElementById("mobile-menu-btn");
            const mobileMenu = document.getElementById("mobile-menu");
            const icon = mobileMenuBtn.querySelector("i");

            mobileMenuBtn.addEventListener("click", function () {
                const opening = mobileMenu.classList.contains("hidden");
                mobileMenu.classList.toggle("hidden");
                mobileMenuBtn.setAttribute("aria-expanded", String(opening));
                icon.className = opening ? "fas fa-times" : "fas fa-bars";
            });

            mobileMenu.addEventListener("click", function (event) {
                if (event.target.tagName === "A") {
                    mobileMenu.classList.add("hidden");
                    mobileMenuBtn.setAttribute("aria-expanded", "false");
                    icon.className = "fas fa-bars";
                }
            });
        });
    </script>
</body>
</html>
