<!DOCTYPE html>
<html lang="en">
<head>
    <base target="_self">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact Us | Consult &amp; Hire</title>
    <meta name="description" content="Contact Consult & Hire to discuss recruitment, talent strategy, current vacancies, candidate support or partnership opportunities.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Patrick+Hand&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            ink: "#171827",
                            navy: "#202B5C",
                            purple: "#6847A8",
                            lilac: "#E9E2F2",
                            lilacSoft: "#F7F3FA",
                            mist: "#F4F5F7",
                            stone: "#E3E5EA",
                            slate: "#64697A",
                            blueSoft: "#EDF3FB",
                            greenSoft: "#EEF6F3"
                        }
                    },
                    fontFamily: {
                        sans: ["Inter", "sans-serif"],
                        hand: ["Patrick Hand", "cursive"]
                    },
                    boxShadow: {
                        soft: "0 18px 45px rgba(31, 37, 69, 0.08)",
                        card: "0 10px 30px rgba(31, 37, 69, 0.07)"
                    }
                }
            }
        };
    </script>

    <style>
        html { scroll-behavior: smooth; }

        body {
            background: #ffffff;
        }

        .mobile-menu {
            display: none;
        }

        .mobile-menu.open {
            display: block;
        }

        .field {
            width: 100%;
            border: 1px solid #D9DCE4;
            border-radius: 14px;
            background: #FFFFFF;
            padding: 0.95rem 1rem;
            color: #171827;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .field:focus {
            outline: none;
            border-color: #6847A8;
            box-shadow: 0 0 0 4px rgba(104, 71, 168, 0.10);
        }

        .contact-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .contact-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 40px rgba(31, 37, 69, 0.10);
        }

        .scribble {
            stroke-linecap: round;
            stroke-linejoin: round;
            fill: none;
        }

        .doodle-float {
            animation: floaty 5s ease-in-out infinite;
        }

        .doodle-float-delay {
            animation: floaty 6s ease-in-out infinite 1.2s;
        }

        @keyframes floaty {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-7px) rotate(1deg); }
        }

        @media (prefers-reduced-motion: reduce) {
            .doodle-float,
            .doodle-float-delay {
                animation: none;
            }
        }
    </style>
</head>

<body class="font-sans text-brand-ink antialiased">

    <!-- Navigation -->
    <header class="sticky top-0 z-50 border-b border-brand-stone/80 bg-white/95 backdrop-blur-xl">
        <nav class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex h-20 items-center justify-between">

                <a href="index.html" class="flex items-center gap-3">
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-navy text-white shadow-sm">
                        <i class="fas fa-briefcase"></i>
                    </div>

                    <div>
                        <p class="text-lg font-bold text-brand-ink">Consult &amp; Hire</p>
                        <p class="text-xs text-brand-slate">Experts in Global Tech Talent</p>
                    </div>
                </a>

                <div class="hidden items-center gap-7 md:flex">
                    <a href="index.html" class="font-medium text-brand-slate transition-colors hover:text-brand-purple">Home</a>
                    <a href="employerhub.html" class="font-medium text-brand-slate transition-colors hover:text-brand-purple">Employer Hub</a>
                    <a href="candidatehub.html" class="font-medium text-brand-slate transition-colors hover:text-brand-purple">Candidate Hub</a>
                    <a href="current-vacancies.html" class="font-medium text-brand-slate transition-colors hover:text-brand-purple">Vacancies</a>
                    <a href="contact.html" class="font-semibold text-brand-purple">Contact Us</a>
                </div>

                <button
                    id="menu-button"
                    type="button"
                    class="text-2xl text-brand-ink md:hidden"
                    aria-label="Open navigation menu"
                    aria-expanded="false"
                >
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div id="mobile-menu" class="mobile-menu border-t border-brand-stone pb-5 md:hidden">
                <div class="flex flex-col gap-3 pt-4">
                    <a href="index.html" class="text-brand-slate hover:text-brand-purple">Home</a>
                    <a href="employerhub.html" class="text-brand-slate hover:text-brand-purple">Employer Hub</a>
                    <a href="candidatehub.html" class="text-brand-slate hover:text-brand-purple">Candidate Hub</a>
                    <a href="current-vacancies.html" class="text-brand-slate hover:text-brand-purple">Vacancies</a>
                    <a href="contact.html" class="font-semibold text-brand-purple">Contact Us</a>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <!-- Simple introduction -->
        <section class="relative overflow-hidden border-b border-brand-stone bg-white">
            <div class="container mx-auto px-4 py-16 sm:px-6 md:py-20 lg:px-8">
                <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr]">

                    <div class="max-w-3xl">
                        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.22em] text-brand-purple">
                            Contact Consult &amp; Hire
                        </p>

                        <h1 class="max-w-3xl text-4xl font-bold leading-tight text-brand-ink md:text-6xl">
                            Let’s have a straightforward conversation.
                        </h1>

                        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-brand-slate md:text-xl">
                            Whether you are hiring, looking for your next role, building recruitment capability or simply exploring an idea, send us a message. No hard sell. No corporate theatre.
                        </p>

                        <p class="mt-5 font-hand text-2xl text-brand-purple">
                            Real people. Honest conversations.
                        </p>
                    </div>

                    <!-- Hand-drawn illustration -->
                    <div class="relative mx-auto w-full max-w-md">
                        <div class="absolute inset-8 rounded-full bg-brand-lilacSoft"></div>

                        <svg
                            viewBox="0 0 460 330"
                            role="img"
                            aria-label="Hand-drawn illustration of two people having a conversation"
                            class="relative z-10 w-full"
                        >
                            <!-- scribbled ground -->
                            <path class="scribble" d="M45 286 C125 275, 175 299, 247 285 S360 277, 418 289" stroke="#C8B6DF" stroke-width="5"/>

                            <!-- left stick person -->
                            <g class="doodle-float">
                                <circle cx="136" cy="108" r="31" fill="#FFFFFF" stroke="#202B5C" stroke-width="5"/>
                                <path class="scribble" d="M111 102 C121 90, 151 86, 163 104" stroke="#202B5C" stroke-width="4"/>
                                <circle cx="126" cy="111" r="2.8" fill="#202B5C"/>
                                <circle cx="147" cy="111" r="2.8" fill="#202B5C"/>
                                <path class="scribble" d="M126 125 C136 132, 147 130, 153 122" stroke="#202B5C" stroke-width="3"/>
                                <path class="scribble" d="M136 139 C131 178, 132 205, 137 238" stroke="#202B5C" stroke-width="6"/>
                                <path class="scribble" d="M135 162 C108 175, 91 193, 77 214" stroke="#202B5C" stroke-width="5"/>
                                <path class="scribble" d="M136 164 C161 169, 181 184, 196 199" stroke="#202B5C" stroke-width="5"/>
                                <path class="scribble" d="M137 237 C120 255, 111 267, 100 282" stroke="#202B5C" stroke-width="5"/>
                                <path class="scribble" d="M137 237 C154 255, 168 270, 178 283" stroke="#202B5C" stroke-width="5"/>
                            </g>

                            <!-- right stick person -->
                            <g class="doodle-float-delay">
                                <circle cx="315" cy="117" r="31" fill="#FFFFFF" stroke="#6847A8" stroke-width="5"/>
                                <path class="scribble" d="M290 106 C301 87, 335 87, 343 109" stroke="#6847A8" stroke-width="4"/>
                                <circle cx="305" cy="119" r="2.8" fill="#6847A8"/>
                                <circle cx="326" cy="119" r="2.8" fill="#6847A8"/>
                                <path class="scribble" d="M305 132 C315 139, 326 136, 332 128" stroke="#6847A8" stroke-width="3"/>
                                <path class="scribble" d="M315 148 C310 182, 311 211, 316 241" stroke="#6847A8" stroke-width="6"/>
                                <path class="scribble" d="M314 169 C289 181, 270 194, 253 211" stroke="#6847A8" stroke-width="5"/>
                                <path class="scribble" d="M315 169 C339 177, 358 190, 373 207" stroke="#6847A8" stroke-width="5"/>
                                <path class="scribble" d="M316 240 C298 257, 285 272, 276 286" stroke="#6847A8" stroke-width="5"/>
                                <path class="scribble" d="M316 240 C335 258, 348 273, 358 286" stroke="#6847A8" stroke-width="5"/>
                            </g>

                            <!-- speech bubbles -->
                            <path class="scribble" d="M68 42 C72 19, 116 15, 139 31 C157 44, 151 65, 130 72 L117 88 L113 70 C86 72, 64 62, 68 42Z" stroke="#202B5C" stroke-width="4" fill="#FFFFFF"/>
                            <path class="scribble" d="M281 35 C289 16, 335 13, 359 29 C379 43, 373 64, 349 72 L342 87 L331 71 C304 72, 274 61, 281 35Z" stroke="#6847A8" stroke-width="4" fill="#FFFFFF"/>

                            <!-- bubble scribbles -->
                            <path class="scribble" d="M88 43 C100 38, 113 39, 126 43" stroke="#202B5C" stroke-width="3"/>
                            <path class="scribble" d="M298 43 C312 37, 331 38, 346 43" stroke="#6847A8" stroke-width="3"/>

                            <!-- loose decorative scribbles -->
                            <path class="scribble" d="M25 135 C8 126, 9 102, 28 95" stroke="#C8B6DF" stroke-width="4"/>
                            <path class="scribble" d="M409 123 C432 115, 441 136, 424 151" stroke="#AFC6EB" stroke-width="4"/>
                            <path class="scribble" d="M61 245 C46 236, 44 222, 52 212" stroke="#AFC6EB" stroke-width="4"/>
                            <path class="scribble" d="M391 246 C411 236, 421 222, 417 208" stroke="#C8B6DF" stroke-width="4"/>
                        </svg>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main contact area -->
        <section class="bg-brand-mist py-14 md:py-18">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr]">

                    <!-- Contact routes -->
                    <div>
                        <p class="mb-3 font-hand text-2xl text-brand-purple">
                            Pick the easiest route
                        </p>

                        <h2 class="mb-6 text-3xl font-bold text-brand-ink">
                            How can we help?
                        </h2>

                        <div class="space-y-4">
                            <a href="clientcalendar.html" class="contact-card flex items-start gap-4 rounded-2xl border border-brand-stone bg-white p-5 shadow-card">
                                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-blueSoft text-brand-navy">
                                    <i class="fas fa-calendar-alt"></i>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-brand-ink">Book a conversation</h3>
                                    <p class="mt-1 text-sm leading-relaxed text-brand-slate">
                                        Choose a convenient time for a relaxed, no-obligation discussion.
                                    </p>
                                </div>
                            </a>

                            <a href="submit-vacancy.html" class="contact-card flex items-start gap-4 rounded-2xl border border-brand-stone bg-white p-5 shadow-card">
                                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-lilacSoft text-brand-purple">
                                    <i class="fas fa-briefcase"></i>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-brand-ink">Submit a vacancy</h3>
                                    <p class="mt-1 text-sm leading-relaxed text-brand-slate">
                                        Send us the basics and we will come back to you with the right next step.
                                    </p>
                                </div>
                            </a>

                            <a href="candidatehub.html" class="contact-card flex items-start gap-4 rounded-2xl border border-brand-stone bg-white p-5 shadow-card">
                                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-greenSoft text-[#52786D]">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div>
                                    <h3 class="font-semibold text-brand-ink">Candidate support</h3>
                                    <p class="mt-1 text-sm leading-relaxed text-brand-slate">
                                        Explore vacancies, career support and candidate resources.
                                    </p>
                                </div>
                            </a>
                        </div>

                        <div class="mt-6 rounded-2xl border border-dashed border-brand-purple/35 bg-brand-lilacSoft p-5">
                            <p class="font-hand text-xl text-brand-purple">
                                Not sure which option fits?
                            </p>
                            <p class="mt-2 text-sm leading-relaxed text-brand-slate">
                                Just use the form. We will make sure your message reaches the right person.
                            </p>
                        </div>
                    </div>

                    <!-- Form -->
                    <div class="rounded-3xl border border-brand-stone bg-white p-6 shadow-soft md:p-9">
                        <div class="mb-7">
                            <p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-brand-purple">
                                Send a message
                            </p>
                            <h2 class="text-3xl font-bold text-brand-ink">
                                Tell us what is on your mind.
                            </h2>
                            <p class="mt-3 leading-relaxed text-brand-slate">
                                Keep it brief or give us the full story. Both are welcome.
                            </p>
                        </div>

                        <!--
                            Replace the form action below with your live form endpoint,
                            CRM integration or form-processing service.
                        -->
                        <form action="#" method="post" class="space-y-5">
                            <div class="grid gap-5 md:grid-cols-2">
                                <div>
                                    <label for="first-name" class="mb-2 block text-sm font-semibold text-brand-ink">
                                        First name
                                    </label>
                                    <input id="first-name" name="first_name" type="text" class="field" autocomplete="given-name" required>
                                </div>

                                <div>
                                    <label for="last-name" class="mb-2 block text-sm font-semibold text-brand-ink">
                                        Last name
                                    </label>
                                    <input id="last-name" name="last_name" type="text" class="field" autocomplete="family-name" required>
                                </div>
                            </div>

                            <div class="grid gap-5 md:grid-cols-2">
                                <div>
                                    <label for="email" class="mb-2 block text-sm font-semibold text-brand-ink">
                                        Email address
                                    </label>
                                    <input id="email" name="email" type="email" class="field" autocomplete="email" required>
                                </div>

                                <div>
                                    <label for="phone" class="mb-2 block text-sm font-semibold text-brand-ink">
                                        Phone <span class="font-normal text-brand-slate">(optional)</span>
                                    </label>
                                    <input id="phone" name="phone" type="tel" class="field" autocomplete="tel">
                                </div>
                            </div>

                            <div>
                                <label for="reason" class="mb-2 block text-sm font-semibold text-brand-ink">
                                    What would you like to discuss?
                                </label>
                                <select id="reason" name="reason" class="field" required>
                                    <option value="">Please select</option>
                                    <option>Hiring or submitting a vacancy</option>
                                    <option>Recruitment strategy or advisory</option>
                                    <option>Talent Academy</option>
                                    <option>Talent Intelligence</option>
                                    <option>Employer brand</option>
                                    <option>Outplacement support</option>
                                    <option>Candidate or career support</option>
                                    <option>Something else</option>
                                </select>
                            </div>

                            <div>
                                <label for="message" class="mb-2 block text-sm font-semibold text-brand-ink">
                                    Your message
                                </label>
                                <textarea id="message" name="message" rows="6" class="field resize-y" placeholder="A few lines is plenty..." required></textarea>
                            </div>

                            <div class="flex items-start gap-3">
                                <input id="privacy" name="privacy" type="checkbox" class="mt-1 h-4 w-4 rounded border-brand-stone text-brand-purple focus:ring-brand-purple" required>
                                <label for="privacy" class="text-sm leading-relaxed text-brand-slate">
                                    I agree that Consult &amp; Hire may use my information to respond to this enquiry.
                                </label>
                            </div>

                            <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center">
                                <button
                                    type="submit"
                                    class="inline-flex items-center justify-center rounded-xl bg-brand-navy px-7 py-4 font-semibold text-white transition-colors hover:bg-brand-purple"
                                >
                                    Send Message
                                    <i class="fas fa-arrow-right ml-2"></i>
                                </button>

                                <p class="font-hand text-xl text-brand-purple">
                                    We’ll get it to the right human.
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        <!-- Simple closing strip -->
        <section class="border-t border-brand-stone bg-white py-12">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
                    <div>
                        <h2 class="text-2xl font-bold text-brand-ink">
                            Prefer to choose a time now?
                        </h2>
                        <p class="mt-2 text-brand-slate">
                            Book directly into our calendar and skip the back-and-forth.
                        </p>
                    </div>

                    <a
                        href="clientcalendar.html"
                        class="rounded-xl border border-brand-navy px-6 py-3 font-semibold text-brand-navy transition-colors hover:bg-brand-navy hover:text-white"
                    >
                        View Available Times
                    </a>
                </div>
            </div>
        </section>
    </main>

    <footer class="border-t border-brand-stone bg-brand-mist py-8">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col items-center justify-between gap-4 text-center md:flex-row md:text-left">
                <p class="text-sm text-brand-slate">
                    &copy; 2026 Consult &amp; Hire. All rights reserved.
                </p>

                <div class="flex gap-5 text-sm">
                    <a href="privacy.html" class="text-brand-slate hover:text-brand-purple">Privacy</a>
                    <a href="terms.html" class="text-brand-slate hover:text-brand-purple">Terms</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        const menuButton = document.getElementById("menu-button");
        const mobileMenu = document.getElementById("mobile-menu");

        menuButton.addEventListener("click", function () {
            const isOpen = mobileMenu.classList.toggle("open");

            menuButton.setAttribute("aria-expanded", String(isOpen));

            menuButton.innerHTML = isOpen
                ? '<i class="fas fa-times"></i>'
                : '<i class="fas fa-bars"></i>';
        });
    </script>

</body>
</html>
